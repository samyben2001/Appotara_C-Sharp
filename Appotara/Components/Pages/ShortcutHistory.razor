@page "/shortcutHistory"
@using Appotara.Models;

<div class="flex flex-col gap-y-2 py-4">
    <h3 class="text-lg font-bold text-orange-400 text-center">Your Shortcuts:</h3>
    @foreach (ShortcutCreated shortcut in allShortcuts)
    {
        <div class="w-full flex flex-row gap-x-2 px-4 cursor-pointer" @onclick="() => SeeShortcutDetail(shortcut)">
            <span class="flex-grow text-zinc-200 hover:bg-zinc-500">@shortcut.Name</span>
            <span class="w-fit text-orange-400" @onclick:stopPropagation="true" @onclick="() => RemoveShortcutFromHistory(shortcut)">&times;</span>
        </div>
    }    
</div>
    