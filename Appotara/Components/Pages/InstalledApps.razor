@page "/installedApps"
@using AppInfos = Appotara.Models.AppInfos;

<div class="h-full w-full absolute top-0 left-0 flex justify-center bg-zinc-800 bg-opacity-75 z-20" style="@(IsVisible ?"display: flex":"display: none" )">
    <div class="h-5/6 w-5/6 flex flex-col self-center bg-zinc-800 rounded-lg">
        <div class="h-8 w-full flex flex-col justify-center border-b-2 border-zinc-300">
            <span class="self-end pr-2 text-orange-400 cursor-pointer" @onclick="ShowModal">&times;</span>
        </div>

        <div class="h-[calc(100%-7rem)] w-full flex flex-col overflow-y-auto scrollbar-thin scrollbar-thumb-orange-400 scrollbar-track-orange-300">

            @foreach (AppInfos app in installedApps)
            {
                <div class="flex flex-row p-4 gap-x-4 text-orange-300 odd:bg-zinc-700">
                    <span class="w-fit flex">
                        <input type="checkbox"
                               class="checkApp"
                               id="@app.Name"
                               name="@app.Name"
                               value="@app.Path" @onclick="() => AddOrRemovePath(app)" />
                    </span>

                    <span class="appName w-3/12 overflow-x-hidden text-ellipsis whitespace-nowrap">
                        <img src="@("data:image/png;base64," + app.Icon)" alt="@("icon " + app.Name)" class="h-8 aspect-1 inline-block" />
                        <span class="pl-2 font-bold">@app.Name</span>
                    </span>

                    <span class="flex-grow overflow-x-hidden text-ellipsis whitespace-nowrap">
                        @app.Path
                    </span>
                </div>
            }
        </div>

        <div class="h-20 w-full flex flex-row justify-evenly items-center border-t-2 border-zinc-300">
            <button class="p-2 w-1/4 h-fit font-bold text-orange-950 bg-orange-300 rounded-full hover:bg-orange-400 active:bg-orange-500 active:outline-none active:ring active:ring-orange-200" @onclick=ValidatePath>Validate</button>
            <button class="p-2 w-1/4 h-fit font-bold text-orange-950 bg-orange-300 rounded-full hover:bg-orange-400 active:bg-orange-500 active:outline-none active:ring active:ring-orange-200" @onclick=BrowseApp>Browse...</button>
        </div>
    </div>
</div>