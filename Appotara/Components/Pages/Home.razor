@page "/"
@using AppInfos = Appotara.Models.AppInfos;


<div class="h-full flex flex-row bg-zinc-700">

    @* Left Side Menu *@
    <div class="w-1/5 h-full border-r-2 border-orange-400">
        <ShortcutHistory OnSeeShortcutDetail="ShowShortcutDetail"/>
    </div>

    @* Right Content *@
    <div class="w-4/5 h-full p-6">

        @* Paths Container *@
        <div class="h-5/6 flex flex-col justify-evenly">

            @* Paths List *@
            <div class="h-5/6 pr-4 flex flex-col justify-normal gap-y-4 overflow-y-auto scrollbar-thin scrollbar-thumb-orange-400 scrollbar-track-orange-300">
            @foreach (AppInfos app in selectedApps)
            {
                    <div class="px-3 py-2 text-zinc-200 border-2 border-zinc-200 border-dashed rounded-md flex flex-row items-center gap-x-4">
                        <span class="appName overflow-hidden text-ellipsis whitespace-nowrap w-3/12">
                            @if(app.Icon is not null){
                                <img src="@("data:image/png;base64," + app.Icon)" alt="@(app.Name + " Icon")" class="h-8 aspect-1 inline-block" />
                            }
                            <span class="pl-2 font-bold">@app.Name</span>
                        </span>

                        <span class="overflow-hidden text-ellipsis whitespace-nowrap flex-grow">
                            @app.Path
                        </span>

                        <span class="text-red-700 text-right font-bold cursor-pointer w-fit" @onclick="() => RemovePath(app)">
                            X
                        </span>
                    </div>
            }

            </div>

            @* AddFile Button *@
            <div class="flex justify-center items-center pt-3">
                <button class="px-8 py-2 font-bold text-orange-950 bg-orange-300 rounded-full hover:bg-orange-400 active:bg-orange-500 active:outline-none active:ring active:ring-orange-200" @onclick="OpenAppSelector">Add files</button>
            </div>
        </div>

        @* Shortcut Creation Container *@
        <div class="h-1/6 w-11/12 flex flex-row items-center">

            @* Shortcut Name *@
            <div class="grow text-center">
                <input type="text" @bind="shortcutName" @bind:event="oninput" name="shortcutName" maxlength="250" placeholder="Shortcut's name" class="w-4/5 px-3 py-1 rounded-full bg-zinc-200" />
            </div>

            @* Shorcut Creation Button *@
            <div>
                @if(shortcutName != "" &&  selectedApps.Count() > 0)
                {
                    <button class="px-8 py-2 font-bold text-orange-950 bg-orange-300 rounded-full hover:bg-orange-400 active:bg-orange-500 active:outline-none active:ring active:ring-orange-200" @onclick="CreateShortcut">Create Shortcut</button>
                }else{
                    <button class="px-8 py-2 font-bold text-orange-950 bg-orange-300 rounded-full cursor-not-allowed opacity-50" disabled>Create Shortcut</button>
                }
            </div>
        </div>
    </div>

</div>

<InstalledApps OnSelectedAppsValidate="HandleSelectedApps" IsVisible=isSelectorVisible/>
