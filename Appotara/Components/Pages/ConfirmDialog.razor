@page "/confirmDialog"

<div class="h-full w-full absolute top-0 left-0 flex justify-center items-center bg-zinc-800 text-zinc-200 bg-opacity-75 z-30">
    <div id="modal-content" class="h-2/6 w-3/6 flex flex-col justify-between p-4 bg-zinc-800 rounded-lg">

        <div id="modal-header" class="flex flex-row justify-between pb-2 font-bold border-b-2 border-solid border-orange-400 ">
            <h5 class="modal-title">@Title</h5>
            <span class="pr-2 text-orange-400 cursor-pointer" @onclick="Cancel">&times;</span>
        </div>

        <div id="modal-body" class="flex-grow p-4">
            <p>@Message</p>
        </div>

        <div id="modal-footer"  class="flex flex-row justify-evenly items-center">
            <div>
                <button class="px-8 py-2 font-bold text-orange-950 bg-orange-300 rounded-full hover:bg-orange-400 active:bg-orange-500 active:outline-none active:ring active:ring-orange-200" @onclick="Confirm">Confirm</button>
            </div>

            <div>
                <button class="px-8 py-2 font-bold text-red-950 bg-red-300 rounded-full hover:bg-red-400 active:bg-orange-500 active:outline-none active:ring active:ring-red-200" @onclick="Cancel">Cancel</button>
            </div>
        </div>

    </div>
</div>